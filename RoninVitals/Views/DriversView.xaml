<UserControl x:Class="RoninVitals.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RoninVitals.ViewModels"
             xmlns:conv="clr-namespace:RoninVitals.Converters"
             xmlns:svc="clr-namespace:RoninVitals.Services">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <svc:BrushKeyConverter x:Key="BrushKey"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Center">
            <Button Content="All areas" Command="{Binding BackCommand}" Style="{StaticResource Vitals.BackButton}"/>
            <TextBlock Text="DRIVER UPDATES" Style="{StaticResource Vitals.Text.Eyebrow}" Margin="0,10,0,6"/>
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Vitals.Text.Headline}" Margin="0,0,0,22"/>

            <!-- Loading -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding LoadingProgress, Mode=OneWay}" Margin="0,0,0,12"
                             Background="{StaticResource Vitals.Surface2.Brush}" BorderThickness="0">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource Vitals.Teal.Color}" Offset="0"/>
                            <GradientStop Color="{StaticResource Vitals.Blue.Color}" Offset="1"/>
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
                <TextBlock Text="{Binding LoadingLabel}" FontFamily="{StaticResource Vitals.Font.Mono}" FontSize="12.5"
                           Foreground="{StaticResource Vitals.Muted.Brush}"/>
            </StackPanel>

            <!-- Results -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Style="{StaticResource Vitals.Text.Body}" FontSize="12.5" Margin="0,0,0,16">
                    <Run Text="{Binding UpdateCount, Mode=OneWay}" Foreground="{StaticResource Vitals.Teal.Brush}" FontFamily="{StaticResource Vitals.Font.Body.SemiBold}" FontWeight="SemiBold"/>
                    <Run Text=" updates found across "/>
                    <Run Text="{Binding VendorCount, Mode=OneWay}" Foreground="{StaticResource Vitals.Teal.Brush}" FontFamily="{StaticResource Vitals.Font.Body.SemiBold}" FontWeight="SemiBold"/>
                    <Run Text=" manufacturers"/>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding VendorGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VendorGroupViewModel}">
                            <StackPanel Margin="0,0,0,18">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding VendorName}" FontFamily="{StaticResource Vitals.Font.Display}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Vitals.Muted.Brush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Height="1" Background="{StaticResource Vitals.Border.Brush}" VerticalAlignment="Center"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriverRowViewModel}">
                                            <Border BorderThickness="2" CornerRadius="12" Padding="13,12" Margin="0,0,0,7"
                                                    Effect="{StaticResource Vitals.CardShadow}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Vitals.Surface.Brush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Vitals.Border.Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Vitals.Surface2.Brush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Vitals.Teal.Brush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" Command="{Binding ToggleSelectedCommand}" Margin="0,0,12,0"
                                                            Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVis}}"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Box" Width="19" Height="19" CornerRadius="6" BorderThickness="1.5"
                                                                                    Background="{StaticResource Vitals.Surface3.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}">
                                                                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource Vitals.Font.Icons}"
                                                                                           FontSize="10" Foreground="{StaticResource Vitals.OnAccent.Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                           Visibility="Collapsed"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Vitals.Teal.Brush}"/>
                                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Vitals.Teal.Brush}"/>
                                                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Border Grid.Column="0" Width="19" Height="19" CornerRadius="6" Opacity="0.3"
                                                            Background="{StaticResource Vitals.Surface3.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}" BorderThickness="1.5" Margin="0,0,12,0"
                                                            Visibility="{Binding IsSelectable, Converter={StaticResource InvBoolToVis}}"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Vitals.Text.Brush}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding IsUpdated, Converter={StaticResource InvBoolToVis}}">
                                                            <TextBlock Text="{Binding CurrentVersion}" FontFamily="{StaticResource Vitals.Font.Mono}" FontSize="11" Foreground="{StaticResource Vitals.Muted.Brush}"/>
                                                            <TextBlock Text=" → " FontFamily="{StaticResource Vitals.Font.Mono}" FontSize="11" Foreground="{StaticResource Vitals.MutedDim.Brush}"/>
                                                            <TextBlock Text="{Binding LatestVersion}" FontFamily="{StaticResource Vitals.Font.Mono}" FontSize="11" Foreground="{StaticResource Vitals.Version.Brush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Up to date" FontFamily="{StaticResource Vitals.Font.Mono}" FontSize="11" Foreground="{StaticResource Vitals.Teal.Brush}"
                                                                   Margin="0,3,0,0" Visibility="{Binding IsUpdated, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center"
                                                            Background="{StaticResource Vitals.Surface3.Brush}">
                                                        <TextBlock Text="{Binding BadgeText}" FontFamily="{StaticResource Vitals.Font.Body.SemiBold}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding BadgeBrushKey, Converter={StaticResource BrushKey}}"/>
                                                    </Border>

                                                    <Button Grid.Column="3" Content="{Binding LinkOutState}" Command="{Binding OpenVendorPageCommand}"
                                                            Style="{StaticResource Vitals.FixButton}" Foreground="{StaticResource Vitals.Yellow.Brush}"
                                                            Visibility="{Binding IsLinkOut, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- Sticky update bar - its own row below the scroll region, so it stays
             pinned to the viewport instead of scrolling away with the list. -->
        <Border Grid.Row="1" Background="{StaticResource Vitals.Surface2.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}"
                BorderThickness="0,1,0,0" Padding="28,14"
                Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
            <Grid MaxWidth="820">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SelectedCountText}" FontSize="12.5" Foreground="{StaticResource Vitals.Muted.Brush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{Binding UpdateButtonLabel}" Style="{StaticResource Vitals.PrimaryButton}"
                        Command="{Binding UpdateSelectedCommand}" IsEnabled="{Binding CanUpdateSelected}" Padding="18,10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
