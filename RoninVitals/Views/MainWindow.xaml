<Window x:Class="RoninVitals.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RoninVitals.ViewModels"
        xmlns:views="clr-namespace:RoninVitals.Views"
        xmlns:svc="clr-namespace:RoninVitals.Services"
        xmlns:models="clr-namespace:RoninVitals.Models"
        Title="Ronin Vitals"
        Icon="/Assets/icon.ico"
        Width="1040" Height="760"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <svc:BrushKeyConverter x:Key="BrushKey"/>
        <svc:SparkAreaFillConverter x:Key="SparkAreaFill"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SymptomsViewModel}">
            <views:SymptomsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <views:DriversView/>
        </DataTemplate>

        <!-- Network/CPU/RAM row - fixed-width pills in a WrapPanel. The Viewbox needs an
             explicit Width here: WrapPanel measures children with infinite available width,
             and an unconstrained Viewbox blows out to fill that instead of its intended size. -->
        <DataTemplate x:Key="VitalTileTemplate" DataType="{x:Type vm:VitalMetricViewModel}">
            <Border Background="{StaticResource Vitals.Surface.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8,12,7" Margin="0,0,10,10" Width="150"
                    Effect="{StaticResource Vitals.CardShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Vitals.Font.Body.SemiBold}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Vitals.Muted.Brush}"/>
                    <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource Vitals.Font.Mono}"
                               FontSize="12.5" Foreground="{StaticResource Vitals.Text.Brush}" Margin="0,2,0,0"/>
                    <Viewbox Width="126" Height="22" Stretch="Fill" Margin="0,4,0,0">
                        <Canvas Width="64" Height="20">
                            <Polyline Points="{Binding Points}" Stroke="{Binding BrushKey, Converter={StaticResource BrushKey}}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Drive row - same look, but no fixed width: the Border/Viewbox stretch to fill
             whatever cell a single-row UniformGrid gives them, so N drives always share one
             line instead of wrapping. Safe to leave unconstrained here because UniformGrid
             (unlike WrapPanel) always measures children with a finite, computed cell width. -->
        <DataTemplate x:Key="DriveTileTemplate" DataType="{x:Type vm:VitalMetricViewModel}">
            <Border Background="{StaticResource Vitals.Surface.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8,12,7" Margin="0,0,10,0"
                    Effect="{StaticResource Vitals.CardShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Vitals.Font.Body.SemiBold}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Vitals.Muted.Brush}"/>
                    <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource Vitals.Font.Mono}"
                               FontSize="12.5" Foreground="{StaticResource Vitals.Text.Brush}" Margin="0,2,0,0"/>
                    <!-- The fill traces the line's own points down to the canvas floor (SparkAreaFill)
                         instead of a fixed full-height Rectangle, so the gradient only ever shades
                         the space under the line - a static Rectangle shaded the same box regardless
                         of how high the line sat, so anything below ~100% used showed most of its
                         "shadow" above the line instead of beneath it. -->
                    <Viewbox Height="22" Stretch="Fill" Margin="0,4,0,0">
                        <Canvas Width="64" Height="20">
                            <Polygon Points="{Binding Points, Converter={StaticResource SparkAreaFill}}" Fill="{StaticResource Vitals.SparkShadow.Brush}"/>
                            <Polyline Points="{Binding Points}" Stroke="{Binding BrushKey, Converter={StaticResource BrushKey}}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Vitals.Bg.Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar / vitals strip ── -->
        <Border Grid.Row="0" Background="{StaticResource Vitals.TopBarOverlay.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}" BorderThickness="0,0,0,1" Padding="28,16,28,14">
            <Grid MaxWidth="920">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The actual app icon asset, not a redrawn copy - can't drift out of
                         sync with the taskbar/title-bar icon because it's the same file. -->
                    <Image Source="/Assets/icon.png" Width="26" Height="26" Margin="0,0,9,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- Single solid-color wordmark, not the split-color icon+two-tone-text combo
                         (the owner's own AI-generated-app research turned up the same layout
                         independently, confirming the icon+wordmark structure itself is sound -
                         it's the two-tone split that reads as templated). Real Bold weight, not
                         synthesized, since Space Grotesk's Bold file shares its family name with
                         Regular/SemiBold (see Typography.xaml note) so FontWeight="Bold" resolves
                         to the actual bold glyphs. -->
                    <TextBlock Text="Ronin Vitals" VerticalAlignment="Center" FontFamily="{StaticResource Vitals.Font.Display}"
                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource Vitals.Text.Brush}"/>
                </StackPanel>

                <!-- Network / CPU / RAM, plus the single drive inline when there's only one.
                     Spans the full topbar width and centers within it (rather than being
                     confined to the column right of the logo), so it lines up with the full-width
                     drive row below by sharing the same center rather than the same left edge. -->
                <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" ItemsSource="{Binding PrimaryVitals}"
                              ItemTemplate="{StaticResource VitalTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Every detected drive, one pill each, side by side - only shown once there's
                     more than one (a single drive stays inline above, in PrimaryVitals). Spans the
                     full topbar width (under the logo too), not just the vitals column, since a
                     machine can have enough drives that the narrower column cramps them. -->
                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" ItemsSource="{Binding DriveVitals}"
                              ItemTemplate="{StaticResource DriveTileTemplate}"
                              Visibility="{Binding HasMultipleDrives, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ── Active screen host (crossfades on navigation, see MainWindow.xaml.cs).
             Each view owns its own ScrollViewer so screens that need a viewport-pinned
             element (the driver update sticky bar) can keep it outside the scroll region. ── -->
        <ContentControl Grid.Row="1" x:Name="ScreenHost" Background="Transparent" Content="{Binding CurrentView}"/>

        <!-- ── Action log - collapsed until the first fix is applied (ShellViewModel.HasLogEntries),
             then stays visible/scrollable for the rest of the session so the user can review what
             changed. Capped height (not full-screen) since it can grow across many fixes. ── -->
        <Border Grid.Row="2" Background="{StaticResource Vitals.Surface2.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}" BorderThickness="0,1,0,0"
                Visibility="{Binding HasLogEntries, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True" MaxHeight="180">
                <TextBlock DockPanel.Dock="Top" Text="ACTION LOG" Style="{StaticResource Vitals.Text.Eyebrow}" Margin="20,10,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,12">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ActionLogEntry}">
                                <Border Background="{StaticResource Vitals.Surface3.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="12.5"
                                                       Foreground="{StaticResource Vitals.Text.Brush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='{}{0:h:mm tt}'}"
                                                       FontFamily="{StaticResource Vitals.Font.Mono}" FontSize="10.5"
                                                       Foreground="{StaticResource Vitals.MutedDim.Brush}" Margin="10,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Vitals.Text.Body}" FontSize="11" Margin="0,3,0,0"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Undone" FontFamily="{StaticResource Vitals.Font.Body.SemiBold}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Vitals.Version.Brush}"
                                                       Visibility="{Binding IsUndone, Converter={StaticResource BoolToVis}}"/>
                                            <Button Grid.Column="1" Content="Undo" Padding="10,4" FontSize="11"
                                                    Background="Transparent" BorderBrush="{StaticResource Vitals.Border.Brush}" BorderThickness="1"
                                                    Foreground="{StaticResource Vitals.Text.Brush}" Cursor="Hand"
                                                    Command="{Binding DataContext.UndoEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
