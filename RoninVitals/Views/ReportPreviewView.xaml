<UserControl x:Class="RoninVitals.Views.ReportPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>

    <!-- The report is shown in a window over the whole app. The dimmed layer swallows clicks, so nothing behind it can be used
         until the user chooses Go back or Save this Report. -->
    <Grid Background="{StaticResource Vitals.Scrim.Brush}">
        <Border Margin="28" MaxWidth="1000" Background="{StaticResource Vitals.Surface.Brush}" BorderBrush="{StaticResource Vitals.Border.Brush}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,16,20,12">
                    <TextBlock Text="REPORT" Style="{StaticResource Vitals.Text.Eyebrow}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Vitals.Font.Display}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Vitals.Text.Brush}"/>
                    <TextBlock Text="This report hasn't been saved. Choose Save this Report to keep a copy."
                               Style="{StaticResource Vitals.Text.Body}" FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- The browser is its own window inside this one, so it always draws above WPF elements: nothing is laid over it. -->
                <Border Grid.Row="1" Margin="20,0" BorderBrush="{StaticResource Vitals.Border.Brush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <TextBlock x:Name="LoadingText" Text="Preparing the report…" Style="{StaticResource Vitals.Text.Body}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextWrapping="Wrap" TextAlignment="Center"/>
                        <wv2:WebView2 x:Name="ReportBrowser"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="20,12,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource Vitals.Text.Body}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- The primary button style has no inner padding, so its size comes from MinWidth and MinHeight. -->
                        <Button x:Name="GoBackButton" Content="Go back" Style="{StaticResource Vitals.FixButton}" Padding="22,11" FontSize="13"
                                Command="{Binding CloseCommand}" Margin="0,0,10,0"/>
                        <Button Content="{Binding SaveButtonLabel}" Style="{StaticResource Vitals.PrimaryButton}" FontSize="13"
                                MinWidth="170" MinHeight="39" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
