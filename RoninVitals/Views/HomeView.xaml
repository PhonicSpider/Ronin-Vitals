<UserControl x:Class="RoninVitals.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RoninVitals.Models"
             xmlns:conv="clr-namespace:RoninVitals.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>

        <Style x:Key="SectionTile" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Vitals.Surface.Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Vitals.Border.Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="18,20,16,18" Effect="{StaticResource Vitals.CardShadow}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Vitals.Surface2.Brush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Vitals.BorderHover.Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconWrap" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,24">
    <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
        <TextBlock Text="RONIN VITALS" Style="{StaticResource Vitals.Text.Eyebrow}" Margin="0,0,0,6"/>
        <TextBlock Text="What area would you like to check?" Style="{StaticResource Vitals.Text.Headline}" Margin="0,0,0,24"/>

        <UniformGrid Columns="4" Rows="1">
            <!-- Network -->
            <Button Style="{StaticResource SectionTile}" Margin="0,0,12,0"
                    Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static models:SectionKey.Network}">
                <StackPanel HorizontalAlignment="Left">
                    <Border Style="{StaticResource IconWrap}" Background="{StaticResource Vitals.BlueDim.Brush}">
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5,12.5 A11,11 0 0,1 19,12.5 M8,16 A6.5,6.5 0 0,1 16,16 M11.5,19.5 L12.5,19.5"
                                      Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Network" Style="{StaticResource Vitals.Text.CardTitle}" Margin="0,14,0,4"/>
                    <TextBlock Text="Connection, speed, and Wi-Fi" Style="{StaticResource Vitals.Text.Body}" FontSize="12"/>
                </StackPanel>
            </Button>

            <!-- Hardware -->
            <Button Style="{StaticResource SectionTile}" Margin="0,0,12,0"
                    Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static models:SectionKey.Hardware}">
                <StackPanel HorizontalAlignment="Left">
                    <Border Style="{StaticResource IconWrap}" Background="{StaticResource Vitals.BlueDim.Brush}">
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="4" Canvas.Top="5" Width="16" Height="11" RadiusX="2" RadiusY="2"
                                           Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"/>
                                <Path Data="M9,20 L15,20 M12,16 L12,20" Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Hardware" Style="{StaticResource Vitals.Text.CardTitle}" Margin="0,14,0,4"/>
                    <TextBlock Text="Performance, heat, and drives" Style="{StaticResource Vitals.Text.Body}" FontSize="12"/>
                </StackPanel>
            </Button>

            <!-- Software -->
            <Button Style="{StaticResource SectionTile}" Margin="0,0,12,0"
                    Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static models:SectionKey.Software}">
                <StackPanel HorizontalAlignment="Left">
                    <Border Style="{StaticResource IconWrap}" Background="{StaticResource Vitals.BlueDim.Brush}">
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="16" Height="16" RadiusX="3" RadiusY="3"
                                           Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"/>
                                <Path Data="M9,9 L7,12 L9,15 M15,9 L17,12 L15,15" Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Software" Style="{StaticResource Vitals.Text.CardTitle}" Margin="0,14,0,4"/>
                    <TextBlock Text="Crashes, updates, and apps" Style="{StaticResource Vitals.Text.Body}" FontSize="12"/>
                </StackPanel>
            </Button>

            <!-- System -->
            <Button Style="{StaticResource SectionTile}"
                    Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static models:SectionKey.System}">
                <StackPanel HorizontalAlignment="Left">
                    <Border Style="{StaticResource IconWrap}" Background="{StaticResource Vitals.BlueDim.Brush}">
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="4" Canvas.Top="4" Width="16" Height="16"
                                         Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"/>
                                <Path Data="M12,4 L12,6 M12,18 L12,20 M4,12 L6,12 M18,12 L20,12" Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="System" Style="{StaticResource Vitals.Text.CardTitle}" Margin="0,14,0,4"/>
                    <TextBlock Text="Windows, updates, and settings" Style="{StaticResource Vitals.Text.Body}" FontSize="12"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Button Style="{StaticResource SectionTile}" Margin="0,12,0,0" HorizontalContentAlignment="Stretch"
                Command="{Binding OpenDriversCommand}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconWrap}" Width="34" Height="34" Background="{StaticResource Vitals.BlueDim.Brush}" Margin="0,0,14,0">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="4" Canvas.Top="4" Width="16" Height="16"
                                     Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"/>
                            <Path Data="M12,8 L12,12 L15,14" Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Check for driver updates" FontFamily="{StaticResource Vitals.Font.Display}"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Vitals.Text.Brush}"/>
                    <TextBlock Text="Scan every driver on your system and update what's safe to update"
                               Style="{StaticResource Vitals.Text.Body}" FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Button>

        <Button Style="{StaticResource SectionTile}" Margin="0,12,0,0" HorizontalContentAlignment="Stretch"
                Command="{Binding CreateRestorePointCommand}" IsEnabled="{Binding RestorePointInProgress, Converter={StaticResource InvBool}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconWrap}" Width="34" Height="34" Background="{StaticResource Vitals.BlueDim.Brush}" Margin="0,0,14,0">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,3 L20,6.5 L20,12 C20,17 16.5,20.5 12,21.5 C7.5,20.5 4,17 4,12 L4,6.5 Z M9,12 L11,14 L15.5,9.5"
                                  Stroke="{StaticResource Vitals.Blue.Brush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Vitals.Font.Display}"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Vitals.Text.Brush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Create a safety checkpoint"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RestorePointInProgress}" Value="True">
                                        <Setter Property="Text" Value="Creating a restore point..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Makes a System Restore point you can roll back to - Windows will ask for admin approval"
                               Style="{StaticResource Vitals.Text.Body}" FontSize="11.5" Margin="0,2,0,0"
                               Visibility="{Binding HasRestorePointMessage, Converter={StaticResource InvBoolToVis}}"/>
                    <TextBlock Text="{Binding RestorePointMessage}" Style="{StaticResource Vitals.Text.Body}" FontSize="11.5" Margin="0,2,0,0"
                               TextWrapping="Wrap" Visibility="{Binding HasRestorePointMessage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Button>
    </StackPanel>
    </ScrollViewer>
</UserControl>
