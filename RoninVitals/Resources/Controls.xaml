<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Section-tile / symptom-card icon glyphs (Segoe MDL2 Assets stand-ins
         for the hand-drawn SVG icons in the HTML prototype until we port the
         real vector paths) ── -->
    <FontFamily x:Key="Vitals.Font.Icons">Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Vitals.IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Vitals.Font.Icons}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Plain link-style back button ── -->
    <Style x:Key="Vitals.BackButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Vitals.Muted.Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource Vitals.Font.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="2,6"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Vitals.Font.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Vitals.Text.Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Small inline "Back to options" link used inside an expanded card ── -->
    <Style x:Key="Vitals.InlineBackButton" TargetType="Button" BasedOn="{StaticResource Vitals.BackButton}">
        <Setter Property="FontFamily" Value="{StaticResource Vitals.Font.Body.SemiBold}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Vitals.Teal.Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Primary teal gradient action button (Run diagnostic / Update Selected) ── -->
    <Style x:Key="Vitals.PrimaryButton" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Vitals.Teal.Color}" Offset="0"/>
                    <GradientStop Color="{StaticResource Vitals.TealDeep.Color}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Vitals.OnAccent.Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource Vitals.Font.Body.SemiBold}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Opacity="{TemplateBinding Tag}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Tag" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Tag" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Secondary "Fix this" chip button ── -->
    <Style x:Key="Vitals.FixButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Vitals.Surface3.Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource Vitals.Teal.Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource Vitals.Font.Body.SemiBold}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{StaticResource Vitals.Border.Brush}" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Faint orange glow standing in for a border on cards/tiles - replaces
         the flat orange outline they used to have. Orange borders are now
         reserved for interactive/selected states (hover, expanded, checked). ── -->
    <!-- Direction/ShadowDepth converted from the mockup's CSS box-shadow(-3px, 4px, 5px)
         - down-left instead of down-right, and a tighter, less diffuse blur. -->
    <DropShadowEffect x:Key="Vitals.CardShadow" Color="{StaticResource Vitals.Teal.Color}"
                       Direction="233" ShadowDepth="5" BlurRadius="8" Opacity="0.4"/>

    <!-- ── Pill toggle switch (Tech Mode). A ToggleButton so IsChecked binds directly -
         no click-handler plumbing needed. Track/thumb sized so the thumb's 20px travel
         plus its own 16px width plus the 3px margin on each side exactly fills the
         42px track. ── -->
    <Style x:Key="Vitals.ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" Width="42" Height="22" CornerRadius="11"
                                Background="{StaticResource Vitals.Surface3.Brush}"
                                BorderBrush="{StaticResource Vitals.Border.Brush}" BorderThickness="1"/>
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{StaticResource Vitals.MutedDim.Brush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Vitals.Teal.Brush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Vitals.OnAccent.Brush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Card container base style (symptom cards, driver rows, vital tiles) ── -->
    <Style x:Key="Vitals.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Vitals.Surface.Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Vitals.Border.Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Effect" Value="{StaticResource Vitals.CardShadow}"/>
    </Style>

    <!-- ── Themed scrollbar thumb - a thin, understated muted-gray pill at rest that
         brightens to cyan on hover/drag, replacing the stock Windows scrollbar chrome.
         Used by the ScrollBar retemplate in App.xaml. ── -->
    <Style x:Key="Vitals.ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{StaticResource Vitals.MutedDim.Brush}" CornerRadius="4" Margin="2" Opacity="0.6"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Vitals.Blue.Brush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Vitals.Blue.Brush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
